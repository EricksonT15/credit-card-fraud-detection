# ==========================================================
# Credit Card Fraud Detection
# Git Ignore Rules
# ==========================================================

# ----------------------------
# Data Files - (too large for GitHub, download via README instructions)
# ----------------------------
data/raw/*.csv
data/raw/*.zip
data/processed/*.csv

# ----------------------------
# Kaggle Credentials (NEVER commit this)
# ----------------------------
kaggle.json

# ----------------------------
# Model files (large binary, optional to track)
# ----------------------------
models/*.pkl
models/*.joblib
models/*.h5

# ----------------------------
# Python
# ----------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
*.egg-info/
.ipynb_checkpoints/

# ----------------------------
# Jupyter
# ----------------------------
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# ----------------------------
# IDE
# ----------------------------
.vscode/
.idea/

# ----------------------------
# Cache
# ----------------------------
.pytest_cache/
.mypy_cache/

# ----------------------------
# Logs
# ----------------------------
*.log

# ----------------------------
# Operating System
# ----------------------------
.DS_Store
Thumbs.db

# ----------------------------
# Google Colab
# ----------------------------
.config/

# ----------------------------
# Preserve Empty Folder Structure
# ----------------------------
!data/raw/.gitkeep
!data/processed/.gitkeep
!models/.gitkeep


Improve .gitignore for project cleanup
