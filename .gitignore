# ── Data files (too large for GitHub, download via README instructions) ──
data/raw/*.csv
data/raw/*.zip
data/processed/*.csv

# ── Kaggle credentials (NEVER commit this) ──
kaggle.json

# ── Model files (large binary, optional to track) ──
models/*.pkl
models/*.joblib
models/*.h5

# ── Python ──
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
*.egg-info/
.ipynb_checkpoints/

# ── Jupyter ──
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# ── OS files ──
.DS_Store
Thumbs.db

# ── Colab ──
.config/

# ── Keep folder structure even though contents are ignored ──
!data/raw/.gitkeep
!data/processed/.gitkeep
!models/.gitkeep
